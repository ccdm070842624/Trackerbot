# Trackerbot Environment Variables Template
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to git!

# ByDFi Exchange API Credentials
# Get these from: https://www.bydfi.com/api-management
BYDFI_API_KEY=your_bydfi_api_key_here
BYDFI_API_SECRET=your_bydfi_api_secret_here

# Telegram Bot Configuration
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Get your chat ID from @userinfobot on Telegram
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Optional: Trading Configuration
# TRADING_SYMBOL=BTC/USDT
# TRADING_TIMEFRAME=1h
# CHECK_INTERVAL=3600

# Optional: Debug Mode
# DEBUG=false
